{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Asia/Tokyo",
  "labels": ["renovate"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": ["update-major"]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "addLabels": ["update-minor"]
    }
  ]
}
